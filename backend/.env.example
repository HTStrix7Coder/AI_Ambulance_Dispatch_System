# Google Maps Platform API Key (Geocoding & Directions)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Database URL (MySQL)
DATABASE_URL=mysql+pymysql://root:password@localhost/medicalsystem

# Local LLM (LM Studio - Port 1234)
LOCAL_LLM_URL=http://localhost:1234/v1/chat/completions
LOCAL_LLM_MODEL=google/gemma-4-12b-qat
LOCAL_LLM_REASONING=off

# VAPI Voice AI Telephony (Optional)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here
